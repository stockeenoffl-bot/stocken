# Zonal Edge - Alice Blue gateway configuration
# Copy to .env next to server.mjs and fill in. NEVER commit the real values.

PORT=8787
DATA_DIR=/opt/zonaledge-gateway/data

# Alice Blue ANT A3 (from https://a3.aliceblueonline.com -> My Apps)
ALICE_BLUE_APP_ID=
ALICE_BLUE_API_SECRET=
ALICE_BLUE_USER_ID=          # your client code, e.g. AB123456
ALICE_BLUE_PUBLIC_IP=        # THIS VPS's public IP (must be whitelisted in A3)

# Supabase - only used to verify admin logins for the Broker page
SUPABASE_URL=                # same as VITE_SUPABASE_URL
SUPABASE_ANON_KEY=           # same as VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=   # optional: allows role lookup from profiles
ADMIN_EMAILS=                # comma separated admin emails (fallback if no service key)

# Allowed browser origins (the website that calls this gateway)
CORS_ORIGIN=https://zonaledge.com
